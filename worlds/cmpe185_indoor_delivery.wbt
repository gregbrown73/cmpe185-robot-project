#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "CMPE 185 Fall 2026 group project"
    "Autonomous indoor delivery with LiDAR localization and navigation"
    "Release 4.0.0: calibrated e-puck drive model and verified nominal route"
  ]
  title "CMPE 185 Autonomous Indoor Delivery"
  basicTimeStep 32
  coordinateSystem "ENU"
}
Viewpoint {
  orientation -0.57735 0.57735 0.57735 2.0944
  position 0 0 10.5
  fieldOfView 0.75
  near 0.05
}
Background {
  skyColor [
    0.86 0.90 0.94
  ]
}
DirectionalLight {
  direction -0.3 -0.2 -1
  intensity 1.2
}

DEF FLOOR Solid {
  translation 0 0 -0.025
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.82 0.84 0.86
        roughness 0.9
        metalness 0
      }
      geometry Box {
        size 8.2 6.2 0.05
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 8.2 6.2 0.05
  }
  locked TRUE
}

# Outer walls
Solid {
  translation -4 0 0.175
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.25 0.34 0.43 roughness 0.7 metalness 0 }
      geometry Box { size 0.10 6.0 0.35 }
    }
  ]
  name "west wall"
  boundingObject Box { size 0.10 6.0 0.35 }
  locked TRUE
}
Solid {
  translation 4 0 0.175
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.25 0.34 0.43 roughness 0.7 metalness 0 }
      geometry Box { size 0.10 6.0 0.35 }
