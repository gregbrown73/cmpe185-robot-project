# Floor markers. These have no bounding objects.
Transform {
  translation -3.2 -2.2 0.006
  children [ Shape { appearance PBRAppearance { baseColor 0.50 0.50 0.50 roughness 0.9 metalness 0 } geometry Cylinder { height 0.01 radius 0.18 } } ]
}
Transform {
  translation -3.2 2.2 0.006
  children [ Shape { appearance PBRAppearance { baseColor 0.12 0.38 0.85 roughness 0.8 metalness 0 } geometry Cylinder { height 0.01 radius 0.18 } } ]
}
Transform {
  translation 1.3 2.2 0.006
  children [ Shape { appearance PBRAppearance { baseColor 0.20 0.68 0.30 roughness 0.8 metalness 0 } geometry Cylinder { height 0.01 radius 0.18 } } ]
}
Transform {
  translation 3.2 -2.2 0.006
  children [ Shape { appearance PBRAppearance { baseColor 0.95 0.48 0.10 roughness 0.8 metalness 0 } geometry Cylinder { height 0.01 radius 0.18 } } ]
}

# The red obstacle appears in LiDAR but is absent from the static map.
DEF DYNAMIC_BLOCK Solid {
  translation 0 0 0.18
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.82 0.08 0.08 roughness 0.65 metalness 0 }
      geometry Box { size 0.45 0.45 0.36 }
    }
  ]
  name "movable unexpected obstacle"
  boundingObject Box { size 0.45 0.45 0.36 }
  locked TRUE
}

DEF STUDENT_ROBOT E-puck {
  translation -3.2 -2.2 0
  rotation 0 0 1 0
  name "CMPE185 e-puck"
  controller "project_starter"
  version "2"
  emitter_channel 7
  receiver_channel 7
  turretSlot [
    Pose {
      translation 0 0 0.055
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.10 0.10 0.12 roughness 0.5 metalness 0.1 }
          geometry Cylinder { height 0.018 radius 0.022 }
        }
        Lidar {
          name "lidar"
          horizontalResolution 360
          fieldOfView 6.283185
          verticalFieldOfView 0.1
          numberOfLayers 1
          near 0.02
          minRange 0.05
          maxRange 4.0
          type "fixed"
          projection "cylindrical"
          noise 0.002
          resolution 0.005
        }
        Display {
          name "student display"
          width 512
          height 512
        }
        Display {
          name "mcl display"
          width 512
          height 512
        }
      ]
    }
  ]
}

Robot {
  name "evaluation supervisor"
  controller "evaluation_supervisor"
  supervisor TRUE
  synchronization TRUE
  children [
    Receiver {
      name "evaluation receiver"
      channel 7
    }
  ]
}
