}
Solid {
  translation 0 -3 0.175
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.25 0.34 0.43 roughness 0.7 metalness 0 }
      geometry Box { size 8.0 0.10 0.35 }
    }
  ]
  name "south wall"
  boundingObject Box { size 8.0 0.10 0.35 }
  locked TRUE
}

# Lower edge of the center corridor, y = -0.6
Solid {
  translation -3.3 -0.6 0.175
  children [ Shape { appearance PBRAppearance { baseColor 0.42 0.49 0.56 roughness 0.8 metalness 0 } geometry Box { size 1.4 0.10 0.35 } } ]
  name "corridor lower west"
  boundingObject Box { size 1.4 0.10 0.35 }
  locked TRUE
}
Solid {
  translation 0 -0.6 0.175
  children [ Shape { appearance PBRAppearance { baseColor 0.42 0.49 0.56 roughness 0.8 metalness 0 } geometry Box { size 2.8 0.10 0.35 } } ]
  name "corridor lower center"
  boundingObject Box { size 2.8 0.10 0.35 }
