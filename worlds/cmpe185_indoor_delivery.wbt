}
Solid {
  translation 3.3 -0.6 0.175
  children [ Shape { appearance PBRAppearance { baseColor 0.42 0.49 0.56 roughness 0.8 metalness 0 } geometry Box { size 1.4 0.10 0.35 } } ]
  name "corridor lower east"
  boundingObject Box { size 1.4 0.10 0.35 }
